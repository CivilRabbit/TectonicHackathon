{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://northwind.local/schemas/source.json",
  "title": "Source",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "title", "date", "country", "claims"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$", "maxLength": 64 },
    "type": { "enum": ["doc", "teams", "email"] },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "date": { "type": "string", "format": "date" },
    "owner": { "type": ["string", "null"], "maxLength": 80 },
    "country": { "enum": ["BE", "NL", "ALL"] },
    "body": { "type": "string", "maxLength": 2000 },
    "claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["topic", "value"],
        "properties": {
          "topic": { "type": "string", "minLength": 1, "maxLength": 128 },
          "value": { "type": "string", "minLength": 1, "maxLength": 64 }
        }
      }
    },
    "supersedesIds": {
      "type": "array",
      "maxItems": 20,
      "items": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$" }
    },
    "referencesIds": {
      "type": "array",
      "maxItems": 20,
      "items": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$" }
    }
  }
}
